# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.
# For deployment, set the same names in GitHub Secrets (nightly Actions job) and Vercel env vars.
#
# 🔴 There is no VITE_ prefix convention in this project, deliberately. Vite's default behaviour
# ships every VITE_*-prefixed variable to the browser automatically, which means one careless
# rename turns a server secret into a public one. web/vite.config.ts instead names each exposed
# variable in an explicit `define` allowlist, so exposing a new value takes a reviewable edit to
# that file. Adding VITE_-prefixed names here would do nothing except mislead the next reader.

# --- Server-side only. NEVER add these to Vercel's build env or vite.config.ts's allowlist. ---
GEMINI_API_KEY=your-gemini-key-from-aistudio.google.com
SUPABASE_SERVICE_KEY=your-supabase-service-key       # bypasses RLS entirely — server only
OPENTOPO_KEY=your-opentopography-key                 # used once to fetch+commit elevation

# --- Read by BOTH the pipeline and the browser bundle ---
# The project URL is not a secret; it appears in every request the app makes. It is listed
# separately from the keys because it is exposed while SUPABASE_SERVICE_KEY must not be.
SUPABASE_URL=https://your-project.supabase.co

# --- Browser-safe by design, not by secrecy ---
# MapTiler: safe once restricted to your deployed domain in the MapTiler dashboard. An
# unrestricted key on a public URL is someone else's free quota being spent.
MAPTILER_KEY=your-maptiler-key
# Supabase anon: a JWT with role "anon". Safe to ship ONLY because the Row Level Security
# policies in supabase/schema.sql limit anon to inserting feedback and device rows. With RLS
# off this is a public read-write handle to the database — the migration is not optional.
SUPABASE_ANON_KEY=your-supabase-anon-key
